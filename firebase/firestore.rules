rules_version = '2';

// Customers read only their own records. Staff access comes from the `role`
// field on the user's own profile document, which only an admin may write.
//
// This project runs on the Spark plan, so there are no Cloud Functions and no
// Admin SDK. Everything a trusted server used to do is enforced here instead:
// enquiry validation, field whitelists and role changes. Rules are therefore
// the only thing standing between a client and the data — keep them strict.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Roles live in Firestore because custom claims need the Admin SDK.
    // Grant the first admin by editing users/{uid}.role in the Firebase Console.
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.get('role', '')
        : '';
    }
    function isStaff() { return role() in ['staff', 'admin']; }
    function isAdmin() { return role() == 'admin'; }
    function owns(data) { return signedIn() && data.customerId == uid(); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(data, key, max) { return !(key in data) || data[key] == null || str(data[key], 0, max); }

    // ---------- Public catalogue ----------
    match /services/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow write: if isStaff();
    }
    match /caseStudies/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow write: if isStaff();
    }

    // ---------- Customer profile ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isStaff());
      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt'])
        && str(request.resource.data.name, 2, 80)
        && request.resource.data.email == request.auth.token.email
        && optStr(request.resource.data, 'phone', 20)
        && request.resource.data.createdAt == request.time;
      // Customers edit their own profile but can never touch `role`.
      // Admins change `role` and nothing else, and never their own.
      allow update: if (signedIn() && uid() == userId
            && onlyChanges(['name', 'phone', 'company', 'updatedAt'])
            && str(request.resource.data.name, 2, 80)
            && optStr(request.resource.data, 'phone', 20)
            && optStr(request.resource.data, 'company', 120))
        || (isAdmin() && userId != uid()
            && onlyChanges(['role', 'updatedAt'])
            && request.resource.data.role in ['customer', 'staff', 'admin']);
      // Account deletion is client-side on Spark: the app clears the
      // subcollections, deletes this document, then deletes the Auth user.
      allow delete: if signedIn() && uid() == userId;

      match /devices/{token} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && str(request.resource.data.platform, 1, 20);
      }

      match /notifications/{id} {
        allow read, delete: if signedIn() && uid() == userId;
        // Customers may only mark as read. Staff raise notifications by hand,
        // because the Firestore triggers that used to do it need Blaze.
        allow update: if (signedIn() && uid() == userId
              && onlyChanges(['read']) && request.resource.data.read == true)
          || isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['title', 'body', 'route', 'read', 'createdAt'])
          && str(request.resource.data.title, 1, 120)
          && str(request.resource.data.body, 1, 500)
          && optStr(request.resource.data, 'route', 200)
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
      }
    }

    // ---------- Enquiries ----------
    // Created by the signed-in customer. The document id is the client's
    // idempotency key, so a retried submit collides instead of duplicating.
    match /enquiries/{id} {
      // `resource == null` lets the app check whether its own idempotency key
      // was already written (safe retry); it reveals nothing.
      allow get: if signedIn() && (resource == null || owns(resource.data) || isStaff());
      allow list: if owns(resource.data) || isStaff();
      allow create: if signedIn()
        && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && request.resource.data.customerId == uid()
        && request.resource.data.keys().hasAll(
             ['name', 'email', 'subject', 'message', 'source', 'customerId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'company', 'subject', 'message', 'source',
              'customerId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'received'
        && request.resource.data.source == 'mobile_app'
        && str(request.resource.data.name, 2, 80)
        && str(request.resource.data.email, 5, 254)
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]{2,}$')
        && request.resource.data.subject in [
             'general', 'web-development', 'wordpress-development', 'shopify-development',
             'app-development', 'game-design', 'ui-ux-design', 'cms-development',
             'crm-development', 'erp-development', 'api-development',
             'ai-agent-development', 'automation-n8n', 'partnership']
        && str(request.resource.data.message, 10, 3000)
        && optStr(request.resource.data, 'phone', 20)
        && optStr(request.resource.data, 'company', 120)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff() && onlyChanges(['status', 'assignedTo', 'internalNotes', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- Quotations and projects (staff-managed) ----------
    match /quotations/{id} {
      allow read: if owns(resource.data) || isStaff();
      allow write: if isStaff();
    }

    match /projects/{projectId} {
      allow read: if owns(resource.data) || isStaff();
      allow write: if isStaff();

      match /milestones/{milestoneId} {
        allow read: if isStaff()
          || (signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.customerId == uid());
        allow write: if isStaff();
      }
    }

    // ---------- Support tickets ----------
    match /tickets/{ticketId} {
      // `resource == null` lets the app check whether its own pre-generated
      // id was already written (safe retry); it reveals nothing.
      allow get: if signedIn() && (resource == null || owns(resource.data) || isStaff());
      allow list: if owns(resource.data) || isStaff();
      allow create: if signedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.keys().hasOnly(
             ['customerId', 'subject', 'category', 'status', 'relatedId', 'lastMessage', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.category in ['general', 'project', 'quotation', 'billing', 'technical']
        && str(request.resource.data.subject, 4, 120)
        && str(request.resource.data.lastMessage, 1, 2000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        || (owns(resource.data)
            && resource.data.status != 'closed'
            && onlyChanges(['lastMessage', 'status', 'updatedAt'])
            && request.resource.data.status == 'open'
            && str(request.resource.data.lastMessage, 1, 2000)
            && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function ticket() { return get(/databases/$(database)/documents/tickets/$(ticketId)).data; }
        // getAfter: the first message is written in the same batch as the ticket.
        function ticketAfter() { return getAfter(/databases/$(database)/documents/tickets/$(ticketId)).data; }
        allow read: if isStaff() || (signedIn() && ticket().customerId == uid());
        allow create: if signedIn()
          && (
            (ticketAfter().customerId == uid()
              && request.resource.data.authorRole == 'customer'
              && ticketAfter().status != 'closed')
            || (isStaff() && request.resource.data.authorRole == 'staff')
          )
          && request.resource.data.authorId == uid()
          && request.resource.data.keys().hasOnly(['authorId', 'authorRole', 'authorName', 'text', 'createdAt'])
          && str(request.resource.data.text, 1, 2000)
          && str(request.resource.data.authorName, 1, 80)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
