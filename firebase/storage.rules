rules_version = '2';

// Private project documents: projects/{projectId}/files/{fileName}
// Readable by staff and the project's customer; writable by staff only.
service firebase.storage {
  match /b/{bucket}/o {
    // Roles live in Firestore, not in custom claims: setting a claim needs the
    // Admin SDK, which needs Cloud Functions, which needs the Blaze plan.
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['staff', 'admin'];
    }
    function projectOwner(projectId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.customerId == request.auth.uid;
    }

    match /projects/{projectId}/files/{fileName} {
      allow read: if isStaff() || projectOwner(projectId);
      allow write: if isStaff()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/zip|text/plain');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
